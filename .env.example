# Database connection string (PostgreSQL e.g. Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/aura_store?schema=public"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Razorpay payment gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional: Email notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

